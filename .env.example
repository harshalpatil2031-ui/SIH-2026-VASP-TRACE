# VASP TRACE runtime configuration. Copy to .env locally; never commit real keys.
# DEMO keeps all traces synthetic. LIVE accepts only live provider data.
# AUTO uses live data only when the required provider key is configured.
VASP_TRACE_MODE=DEMO

# Obtain these from the providers' own developer portals.
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
BITQUERY_API_KEY=

# Guardrails for the investigation trace coordinator.
TRACE_REQUEST_TIMEOUT_SECONDS=5
TRACE_MAX_HOPS=4
TRACE_MAX_TRANSFERS_PER_WALLET=25
TRACE_MAX_WALLET_QUERIES_PER_TRACE=16
TRACE_MAX_CHILDREN_PER_WALLET=4
TRACE_MAX_DURATION_SECONDS=20
